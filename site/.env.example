# Copy to .env.local. Never commit real values.

# --- Clerk (auth) ---------------------------------------------------------
# Leave BOTH of these unset to run in Clerk "keyless" mode: in dev, Clerk
# creates a temporary instance automatically and shows a "claim your
# application" prompt. When you claim it (or create an app at
# https://dashboard.clerk.com), paste the keys here.
# Publishable key is public by design; the secret key is server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Sign-in methods (phone OTP + Google) are switched on in the Clerk
# dashboard under User & Authentication, not in code.

# --- Fixie backend --------------------------------------------------------
# Base URL of the Fixie server (server/). Only the Next.js server calls it.
FIXIE_API_URL=http://localhost:3000

# Admin token the backend expects in the `x-admin` header (same value as
# the server's admin token). Attached by route handlers server-side only;
# it is never sent to the browser. Needed for "Stop job".
FIXIE_ADMIN_TOKEN=
