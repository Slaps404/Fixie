# Copy to .env.local. Never commit real values.

# --- Sessions (required) ----------------------------------------------------
# Signs the login cookie. Any random string of 32+ characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# --- Twilio Verify: the text-message code at sign-up --------------------------
# Verify needs no 10DLC registration. Find the first two in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Run `npm run verify:create` once to make a Verify service; paste the SID it prints.
TWILIO_VERIFY_SERVICE_SID=

# --- Stripe Checkout: the card step (test mode) ------------------------------
# Use an sk_test_ key. Run `npm run stripe:create` once to make the $9/mo price.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# --- Test mode ---------------------------------------------------------------
# Set to 1 to let sign-up work with no Twilio or Stripe keys: no text is sent,
# the code is 000000, and the card step is skipped with a "Test mode" label.
# Leave unset anywhere the public can reach.
SIGNUP_TEST_MODE=

# --- Fixie backend -----------------------------------------------------------
# Base URL of the Fixie server (server/). Only the Next.js server calls it.
FIXIE_API_URL=http://localhost:3000
# Admin token the backend expects in the `x-admin` header. Attached by route
# handlers server-side only and never sent to the browser. Needed for "Stop job".
FIXIE_ADMIN_TOKEN=

# --- Optional ----------------------------------------------------------------
# Public base URL, used for the Stripe return link. Needed behind a tunnel or proxy
# that does not forward the Host header.
APP_URL=
