# Copy to .env in the repo root (gitignored). It is the only secrets file:
# server/ and site/ both load it. Never commit real keys.

# === Server (server/) ========================================================
PORT=3000
# Public tunnel URL, e.g. from: cloudflared tunnel --url http://localhost:3000
PUBLIC_URL=
# Leave VAPI_API_KEY empty or set DRY_RUN=1 to simulate all calls.
DRY_RUN=0
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_INTAKE_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
VAPI_VOICE_ID=
FIXIE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
SIM_SPEED=1
# Web search for the voice agent and online vendor quotes.
EXA_API_KEY=
# Real ordering (docs/issues/16-real-ordering.md). Sandbox key from app.lithic.com.
LITHIC_API_KEY=
COMMERCE=
# Card vault: CARD_ENC_KEY is 32 random bytes, base64 (openssl rand -base64 32).
# `npm run vault:put` prints ORDER_CARD_TOKEN.
CARD_ENC_KEY=
ORDER_CARD_TOKEN=

# === Shared by server and site ===============================================
# Admin token: the server checks it in the `x-admin` header; the site attaches
# it server-side only (never sent to the browser). Needed for "Stop job".
ADMIN_TOKEN=
# Admin console login (server /admin and site /admin).
ADMIN_USER=
ADMIN_PASS=
# Twilio: Verify codes at sign-up (site) and photo texts (server).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# === Site (site/) ============================================================
# Signs the login cookie. Any random string of 32+ characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=
# Run `npm run verify:create` (in site/) once; paste the SID it prints.
TWILIO_VERIFY_SERVICE_SID=
# Stripe Checkout, test mode. Use an sk_test_ key. Run `npm run stripe:create` once for the $9/mo price.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Set to 1 to let sign-up work with no Twilio or Stripe keys: no text is sent,
# the code is 000000, and the card step is skipped with a "Test mode" label.
# Leave unset anywhere the public can reach.
SIGNUP_TEST_MODE=
# Base URL of the Fixie server. Only the Next.js server calls it.
FIXIE_API_URL=http://localhost:3000
# Public base URL, used for the Stripe return link. Needed behind a tunnel or proxy
# that does not forward the Host header.
APP_URL=
