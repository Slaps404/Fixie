# Copy to .env (gitignored). Never commit real keys.
PORT=3000
# Public tunnel URL, e.g. from: cloudflared tunnel --url http://localhost:3000
PUBLIC_URL=
# Leave VAPI_API_KEY empty or set DRY_RUN=1 to simulate all calls.
DRY_RUN=0
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_INTAKE_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=
VAPI_VOICE_ID=
FIXIE_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
SIM_SPEED=1
